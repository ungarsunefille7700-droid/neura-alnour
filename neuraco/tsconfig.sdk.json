{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": "dist-sdk"
  },
  "include": [
    "sdk/**/*.ts",
    "cli/api-client.ts"
  ],
  "exclude": [
    "sdk/**/*.test.ts",
    "cli/**/*.test.ts"
  ]
}
