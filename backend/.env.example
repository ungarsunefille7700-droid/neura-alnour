MONGO_URL="mongodb://localhost:27017"
DB_NAME="neura_alnour"
CORS_ORIGINS="https://your-domain.com,https://www.your-domain.com"
EMERGENT_LLM_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
FREE_TEXT_WINDOW_HOURS=5
FREE_TEXT_ADVANCED_BUDGET_UNITS=120000
FREE_TEXT_MEDIUM_BUDGET_UNITS=60000
FREE_TEXT_MEDIUM_MAX_TOKENS=768
FREE_CHATGPT_ADVANCED_MODEL=gpt-4o
FREE_CHATGPT_MEDIUM_MODEL=gpt-4o-mini
FREE_CLAUDE_ADVANCED_MODEL=claude-sonnet-4-5
FREE_CLAUDE_MEDIUM_MODEL=claude-haiku-4-5
FREE_GEMINI_ADVANCED_MODEL=gemini-2.5-flash
FREE_GEMINI_MEDIUM_MODEL=gemini-2.0-flash-lite
FREE_GROK_ADVANCED_MODEL=gemini-2.5-flash
FREE_GROK_MEDIUM_MODEL=gemini-2.0-flash-lite
FREE_IMAGE_WINDOW_HOURS=24
FREE_IMAGE_MAX_UPLOADS=3
FREE_IMAGE_ANALYSIS_BUDGET_UNITS=30000
FREE_IMAGE_MAX_BYTES=5242880
MONGO_TEXT_WINDOW_HOURS=3
MONGO_TEXT_ADVANCED_BUDGET_UNITS=600000
MONGO_TEXT_MEDIUM_BUDGET_UNITS=300000
MONGO_TEXT_ADVANCED_MAX_TOKENS=2048
MONGO_TEXT_MEDIUM_MAX_TOKENS=1024
MONGO_TEXT_ECONOMIC_MAX_TOKENS=768
MONGO_CHAT_HISTORY_MESSAGES=100
MONGO_CHATGPT_MEDIUM_MODEL=gpt-4o-mini
MONGO_CHATGPT_ECONOMIC_MODEL=gpt-4.1-nano
MONGO_CLAUDE_MEDIUM_MODEL=claude-haiku-4-5
MONGO_CLAUDE_ECONOMIC_MODEL=claude-3-5-haiku-20241022
MONGO_GEMINI_MEDIUM_MODEL=gemini-2.0-flash-lite
MONGO_GEMINI_ECONOMIC_MODEL=gemini-2.0-flash-lite
MONGO_GROK_MEDIUM_MODEL=gemini-2.0-flash
MONGO_GROK_ECONOMIC_MODEL=gemini-2.0-flash-lite
MONGO_IMAGE_WINDOW_HOURS=24
MONGO_IMAGE_MAX_UPLOADS=50
MONGO_IMAGE_ANALYSIS_BUDGET_UNITS=60000
MONGO_IMAGE_GENERATION_WINDOW_HOURS=24
MONGO_IMAGE_GENERATION_LIMIT=20
STRIPE_API_KEY=
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
JWT_SECRET=
VIP_ADMIN_1_EMAIL=
VIP_ADMIN_1_PASSWORD=
VIP_ADMIN_2_EMAIL=
VIP_ADMIN_2_PASSWORD=

# --- Neura engine + Neura Gateway (own API, own nan_ keys) ---
# emergent (default: previous behaviour) | cloudflare | openai_compatible (self-hosted engine)
NEURA_INFERENCE_PROVIDER=emergent
# Cloudflare Workers AI (free plan, no card): account id + API token "Workers AI: Read"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Self-hosted engine later (vLLM / llama.cpp / Ollama, OpenAI format)
NEURA_ENGINE_URL=
NEURA_ENGINE_API_KEY=
NEURA_ENGINE_MODEL=@cf/google/gemma-4-26b-a4b-it
NEURA_ENGINE_DISABLE_THINKING=true
# Code (measured 2026-10-15 on whole projects): paid/VIP -> gpt-oss-120b, free -> gemma-4
NEURA_ENGINE_CODE_MODEL=@cf/openai/gpt-oss-120b
NEURA_ENGINE_CODE_MODEL_FREE=@cf/google/gemma-4-26b-a4b-it
NEURA_ENGINE_CODE_MAX_OUTPUT_TOKENS=6000
NEURA_PUBLIC_MODEL_NAME=neura-al-noor
# on = images/tools/other voices keep the previous (paid) providers; off = strict free mode
NEURA_LEGACY_AI=on
NEURA_ENGINE_MAX_OUTPUT_TOKENS=700
NEURA_ENGINE_MAX_INPUT_TOKENS=6000
NEURA_ENGINE_HISTORY_MESSAGES=10
NEURA_ENGINE_DIGEST_CHARS=160
NEURA_ENGINE_DIGEST_ITEMS=12
# Daily Neuron budget (Cloudflare free = 10,000/day, reset 00:00 UTC) and per-user limits
NEURA_AI_DAILY_NEURONS=9000
NEURA_AI_FREE_SHARE=0.7
NEURA_AI_USER_NEURONS_FREE=250
NEURA_AI_USER_NEURONS_PAID=900
NEURA_AI_USER_NEURONS_VIP=unlimited
# Saturation: simultaneous inferences, queue size/timeout, requests per minute
NEURA_AI_MAX_CONCURRENT=20
NEURA_AI_MAX_QUEUE=100
NEURA_AI_QUEUE_TIMEOUT=25
NEURA_AI_RPM=280
NEURA_AI_CACHE=on
NEURA_AI_CACHE_DAYS=7
# legacy | engine (engine STT = Whisper turbo; engine TTS = MeloTTS, French/English only)
NEURA_VOICE_STT_PROVIDER=legacy
NEURA_VOICE_TTS_PROVIDER=legacy
# Secret used to hash nan_ keys (defaults to JWT_SECRET; changing it invalidates all keys)
NEURA_API_KEY_PEPPER=
